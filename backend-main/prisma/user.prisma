model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique 
  pass         String
  createdAt    DateTime  @default(now()) 
  updatedAt    DateTime  @updatedAt     
  id_atendente String?   @unique
  typeUser     TypeUsers @default(atendente)
  plantao       Plantonistas?
  registros    Registros[] 
}
  
enum TypeUsers {
  atendente
  admin
  gestor
}